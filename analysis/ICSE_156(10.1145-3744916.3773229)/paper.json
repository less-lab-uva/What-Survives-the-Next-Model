{
  "title": "ConfuGuard: Using Metadata to Detect Active and Stealthy Package Confusion Attacks Accurately and at Scale",
  "doi": "10.1145/3744916.3773229",
  "venue": "ICSE 2026",
  "summary": [
    "The original ConfuGuard pipeline detects package-confusion/typosquat attacks by combining typosquat candidate generation with registry metadata analysis to classify a suspected package as a threat or benign.",
    "This reproduction replaces that whole metadata pipeline with a single-LLM prompt that, given a package name + registry, returns a binary is_typosquat judgment."
  ],
