{
  "title": "TraceCoder: A Trace-Driven Multi-Agent Framework for Automated Debugging of LLM-Generated Code",
  "doi": "10.1145/3744916.3773187",
  "venue": "ICSE 2026",
  "summary": [
    "The original TraceCoder pipeline instruments generated code, collects fine-grained runtime traces, analyzes failures with multiple agents, repairs code iteratively, learns from historical failed attempts, and rolls back when a repair regresses.",
    "This reproduction replaces that trace-driven multi-agent debugging workflow with a simplified single-LLM prompt that directly generates the completed function or class."
  ],
