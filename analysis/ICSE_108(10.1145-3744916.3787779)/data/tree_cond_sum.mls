type nat =
  | O
  | S of nat

type bool =
  | True
  | False

type cmp =
  | LT
  | EQ
  | GT

type treecond = 
  | Leaf of nat
  | Node of nat * cmp * nat * treecond * treecond

let eqcmp = 
  fix (eqcmp : cmp -> cmp -> bool) =
    fun (cop1 : cmp) ->
      fun (cop2 : cmp) ->
        match cop1 with
        | EQ _ -> (match cop2 with
                   | EQ _ -> True 
                   | LT _ -> False
                   | GT _ -> False)
        | LT -> (match cop2 with
                   | EQ _ -> False 
                   | LT _ -> True
                   | GT _ -> False)
        | GT -> (match cop2 with
                   | EQ _ -> False 
                   | LT _ -> False
                   | GT _ -> True)
;;
let compare =
  fix (compare : nat -> nat -> cmp) =
    fun (x1 : nat) ->
      fun (x2 : nat) ->
        match x1 with
        | O -> (match x2 with
                | O -> EQ
                | S _ -> LT)
        | S x1p -> (match x2 with
                | O -> GT
                | S x2p -> compare x1p x2p)
;;

let add =
  fix (add : nat -> nat -> nat) =
    fun (n1 : nat) ->
      fun (n2 : nat) ->
        match n1 with
        | O -> n2
        | S n1p -> S (add n1p n2)
;;

synth treecond -> nat -> nat satisfying

[Leaf(5), 0] -> 5,
[Leaf(5), 2] -> 5,
[Node(2, EQ, 3, Leaf(3), Leaf(2)), 3] -> 5,
[Node(2, EQ, 2, Leaf(3), Leaf(2)), 3] -> 4,
[Node(2, GT, 2, Node(5, LT, 4, Leaf(0), Leaf(1)), Node(3, EQ, 1, Leaf(3), Leaf(2))), 2] -> 7,
[Node(2, GT, 2, Node(5, LT, 4, Leaf(0), Leaf(1)), Node(3, EQ, 1, Leaf(3), Leaf(2))), 3] -> 7,
[Node(2, GT, 2, Node(5, LT, 4, Leaf(0), Leaf(1)), Node(3, EQ, 1, Leaf(3), Leaf(2))), 5] -> 8