type nat =
  | O
  | S of nat

type list =
  | Nil
  | Cons of nat * list

type bool =
  | True
  | False

let sum =
  fix (sum : nat -> nat -> nat) =
    fun (n1 : nat) ->
      fun (n2 : nat) ->
        match n1 with
        | O -> n2
        | S n1p -> S (sum n1p n2)
;;

synth (nat -> nat -> nat) -> nat -> list -> nat satisfying

[sum,0,Nil] -> 0,
[sum,0,Cons(2,Cons(1,Nil))] -> 3,
[sum,0,Cons(3,Cons(2,Cons(1,Nil)))] -> 6,