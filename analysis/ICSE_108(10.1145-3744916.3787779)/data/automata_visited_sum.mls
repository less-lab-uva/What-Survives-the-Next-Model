type nat =
  | O
  | S of nat

type bool =
  | True
  | False

type cmp =
  | LT
  | EQ
  | GT

type automata = 
  | State of nat
  | Trans of nat * cmp * nat * automata

let eqcmp = 
  fix (eqcmp : cmp -> cmp -> bool) =
    fun (cop1 : cmp) ->
      fun (cop2 : cmp) ->
        match cop1 with
        | EQ _ -> (match cop2 with
                   | EQ _ -> True 
                   | LT _ -> False
                   | GT _ -> False)
        | LT -> (match cop2 with
                   | EQ _ -> False 
                   | LT _ -> True
                   | GT _ -> False)
        | GT -> (match cop2 with
                   | EQ _ -> False 
                   | LT _ -> False
                   | GT _ -> True)
;;
let compare =
  fix (compare : nat -> nat -> cmp) =
    fun (x1 : nat) ->
      fun (x2 : nat) ->
        match x1 with
        | O -> (match x2 with
                | O -> EQ
                | S _ -> LT)
        | S x1p -> (match x2 with
                | O -> GT
                | S x2p -> compare x1p x2p)
;;

let add =
  fix (add : nat -> nat -> nat) =
    fun (n1 : nat) ->
      fun (n2 : nat) ->
        match n1 with
        | O -> n2
        | S n1p -> S (add n1p n2)
;;

synth automata -> nat -> nat satisfying

[State(5), 0] -> 5,
[State(5), 2] -> 5,
[Trans(2, EQ, 3, State(3)), 3] -> 5,
[Trans(2, EQ, 2, State(3)), 3] -> 2,
[Trans(1, GT, 2, Trans(2, LT, 4, State(3))), 2] -> 1,
[Trans(1, GT, 2, Trans(2, LT, 4, State(3))), 3] -> 6,
[Trans(1, GT, 2, Trans(2, LT, 4, State(3))), 5] -> 3