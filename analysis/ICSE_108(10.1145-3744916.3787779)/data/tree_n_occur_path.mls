type nat =
  | O
  | S of nat

type tree = 
  | Leaf of nat
  | Node of nat * tree * tree

type cmp =
  | LT
  | EQ
  | GT

let compare =
  fix (compare : nat -> nat -> cmp) =
    fun (x1 : nat) ->
      fun (x2 : nat) ->
        match x1 with
        | O -> (match x2 with
                | O -> EQ
                | S _ -> LT)
        | S x1p -> (match x2 with
                | O -> GT
                | S x2p -> compare x1p x2p)
;;

let add =
  fix (add : nat -> nat -> nat) =
    fun (n1 : nat) ->
      fun (n2 : nat) ->
        match n1 with
        | O -> n2
        | S n1p -> S (add n1p n2)
;;

synth tree -> nat -> nat -> nat satisfying

[Leaf (3), 0, 0] -> 0,
[Leaf (2), 2, 0] -> 0,
[Leaf (2), 2, 1] -> 1,
[Leaf (0), 0, 1] -> 1,
[Node (2, Leaf(3), Leaf(2)), 2, 1] -> 1,
[Node (2, Leaf(3), Leaf(2)), 2, 2] -> 1,
[Node (2, Leaf(3), Leaf(2)), 2, 4] -> 0,
[Node (1, Leaf(3), Leaf(0)), 3, 1] -> 1,
[Node (3, Leaf(3), Leaf(0)), 3, 1] -> 1,
[Node (3, Leaf(3), Leaf(0)), 3, 2] -> 1,
[Node (2, Node(4, Leaf(2), Leaf(2)), Leaf(2)), 2,2] -> 3