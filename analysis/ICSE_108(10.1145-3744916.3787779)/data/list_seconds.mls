type nat =
  | O
  | S of nat

type list =
  | Nil
  | Cons of nat * list

type llist =
  | LNil
  | LCons of list * llist

synth llist -> list satisfying

[LNil] -> Nil,
[LCons(Cons(1,Cons(2,Cons(3,Nil))), LCons(Cons(4,Cons(2,Cons(3,Nil))), LCons(Cons(2,Cons(2,Cons(3,Nil))), LNil)))] -> Cons(2,Cons(2,Cons(2,Nil))),
[LCons(Cons(1,Cons(1,Nil)), LCons(Cons(3,Cons(4,Nil)), LNil))] -> Cons(1,Cons(4,Nil)),
[LCons(Cons(0,Cons(1,Nil)), LNil)] -> Cons(1,Nil),