type nat =
  | O
  | S of nat

type bool =
  | True
  | False

type list =
  | Nil
  | Cons of nat * list

type natopt =
  | None
  | Some of nat

synth list -> nat -> natopt satisfying

[Cons (1, Cons (2, Cons (3, Cons (4, Cons (5, Nil))))), 1] -> Some(2),
[Cons (2, Cons (3, Cons (4, Cons (1, Nil)))), 3] -> Some(1),